{
  "name": "beadcause",
  "version": "0.1.0",
  "description": "Mobile decision inbox for beads (bd) human-needed issues, over Tailscale, with ntfy push",
  "type": "module",
  "private": true,
  "license": "ISC",
  "bin": {
    "beadcause": "bin/beadcause.js",
    "beadcause-monitor": "bin/monitor.js",
    "beadcause-memory": "bin/beadcause-memory",
    "beadcause-agentrepo": "bin/beadcause-agentrepo",
    "beadcause-get": "bin/beadcause-get",
    "beadcause-browse": "bin/beadcause-browse",
    "beadcause-confluence": "bin/beadcause-confluence",
    "beadcause-file": "bin/file.js",
    "beadcause-propose": "bin/propose.js",
    "beadcause-ask": "bin/ask.js",
    "beadcause-deliver": "bin/deliver.js",
    "beadcause-checkin": "bin/checkin.js",
    "beadcause-plan": "bin/plan.js",
    "beadcause-attic": "bin/attic.js"
  },
  "scripts": {
    "start": "node bin/router.js",
    "start:bare": "node bin/beadcause.js",
    "swap": "node bin/router.js --swap",
    "swap:status": "node bin/router.js --status",
    "test": "node scripts/test.mjs",
    "checks": "node scripts/checks.mjs",
    "qr": "node bin/beadcause.js --qr",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js",
    "monitor": "node bin/monitor.js",
    "timings": "node scripts/timings.mjs",
    "check": "node scripts/check-agent-log.js",
    "secrets": "node scripts/secret-scan.mjs",
    "conflicts": "node scripts/conflict-check.mjs",
    "demo": "node scripts/demo-question.js",
    "configure": "node scripts/configure.js",
    "onboard": "node scripts/onboard.mjs",
    "install-service": "bash scripts/install.sh",
    "uninstall-service": "bash scripts/uninstall.sh",
    "android": "bash scripts/build-android.sh",
    "android:key": "bash scripts/android-keystore.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  }
}
