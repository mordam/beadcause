<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Beadcause" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <!-- The WebView paints its own light/dark surface from the PWA's stylesheet,
             so the window behind it should be transparent to whichever it picked
             rather than flashing the wrong one on every launch. -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
    </style>

    <style name="Theme.Beadcause.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/brand</item>
    </style>
</resources>
