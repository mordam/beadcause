<!--
  The themed-icon layer: what a launcher with "Themed icons" on draws instead of the
  colour foreground. Same lockup, same coordinates, same 0.80 fit as
  ic_launcher_foreground — only the colour differs, because Android keeps just the
  alpha here and paints it in the wallpaper's palette.

  This used to be @drawable/ic_notification, which was fine while both were the same
  strand. It cannot be shared any more: the status bar renders at 24dp, where five
  letters on two lines are a smear, so ic_notification keeps a glyph drawn for that
  size and this file carries the mark. Nothing is filled — every counter in b, d and o
  stays transparent, so the theming does not flood them solid.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.80"
        android:scaleY="0.80">

        <path
            android:pathData="M164,149 L164,253"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="30"
            android:strokeLineCap="round" />
