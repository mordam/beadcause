<!--
  "bdcoz", ported from public/icon.svg so the app icon and the PWA are the same thing.
  Kept on the source's 512 viewport, with the same coordinates and the same 30-wide
  strokes, so the two can be diffed line for line rather than drifting apart.

  Two differences are forced by the format and the mask:
    - vector drawables have no <circle>, so each bowl is an arc pair;
    - the launcher only guarantees the central 66dp of 108dp — a circle of radius 156
      on this viewport, tighter than the 205 the PWA's "maskable" purpose asks for.
      The farthest ink is the z's bottom-right corner, 194 out, so the group scales to
      0.80 about the centre and lands at 155. There is no translate, unlike the strand
      this replaces: the lockup is drawn centred on (256,256) to begin with.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.80"
        android:scaleY="0.80">

        <!-- bd: stem, bowl / bowl, stem — the two are mirrors of each other -->
        <path
            android:pathData="M164,149 L164,253"
            android:strokeColor="#5eead4"
            android:strokeWidth="30"
            android:strokeLineCap="round" />
        <path
            android:pathData="M164,219 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0"
            android:strokeColor="#5eead4"
            android:strokeWidth="30" />
        <path
            android:pathData="M280,219 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0"
            android:strokeColor="#5eead4"
            android:strokeWidth="30" />
        <path
            android:pathData="M348,149 L348,253"
            android:strokeColor="#5eead4"
            android:strokeWidth="30"
            android:strokeLineCap="round" />

        <!-- coz. The c is the o with 110° taken out of its right side. -->
        <path
            android:pathData="M166.5,301.15 a34,34 0 1,0 0,55.7"
            android:strokeColor="#5eead4"
            android:strokeWidth="30"
            android:strokeLineCap="round" />
        <path
            android:pathData="M229,329 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0"
            android:strokeColor="#5eead4"
            android:strokeWidth="30" />
        <path
            android:pathData="M345,295 L399,295 L345,363 L399,363"
            android:strokeColor="#5eead4"
            android:strokeWidth="30"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
