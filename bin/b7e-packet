#!/usr/bin/env node
/**
 * `b7e-packet` — file an approval question, label it so the desk queries can find it, and
 * record the filer's step on the relay trail. One call, where five hand-typed sessions
 * each ran the same five and the same one failed.
 *
 *   b7e-packet -w deluvia -b dv-abc -t "Ship the Q3 pricing page?" -f packet.md
 *   b7e-packet -w deluvia -b dv-abc -t "..." -f packet.md --artifact https://claude.ai/...
 *   cat packet.md | b7e-packet -w deluvia -b dv-abc -t "..." --from ward
 *
 * `bc-dgx7.80` names five sessions (`dv-gr6.38`, `dv-gr6.41`, `dv-gr6.43`, `dv-b5d.4.3`,
 * `dv-5eu.1.1`) that each ended a Story-chain relay with the same five calls in the same
 * order: `ask.js`, two `bd label add`, `relaystep --next adam`, then a retry once the
 * fourth was rejected. Two things about that were never going to fix themselves by
 * repetition:
 *
 * - **Two labels, applied one at a time, leave a window where the bead carries only one.**
 *   `ask.js` applies `human`; `needs-approval` came after, as a second write, so a desk
 *   query that selects on both labels could read the bead between them. Both are applied
 *   in the single `bd create` that files the bead, so there is no window to be caught in.
 * - **`--next adam` was never going to be accepted, and retyping it never taught anyone
 *   that.** The relay vocabulary is role names — `aria`, `clio`, `ward` — and Adam is not
 *   one; five sessions independently reasoned the packet goes to him, because it does,
 *   and the relay step this files carries no `--next` at all. The step says who filed and
 *   what happened; where it goes next is the `needs-approval`/`human` pair, not a role.
 *
 * ## What it does
 *
 * 1. Refuses before anything is written: the body must end with a `decision` block
 *    (`lib/decision.js`, the same rule `bin/ask.js` enforces — pass `--no-options` for a
 *    packet that is a plain go/no-go rather than a choice with more than one shape), `-b`
 *    must name a bead that exists in the workspace, and `--from <role>` — or the
 *    workspace's relay filer, when neither is given — must be a role the workspace's
 *    relay actually has, where the workspace has one at all.
 * 2. Files the question: `bd create` with both of the workspace's packet labels
 *    (`needs-approval`, `human` — `lib/relay.js`'s `packetFor`, a per-workspace default) in
 *    the one call, plus the addressee label `bin/ask.js` also stamps.
 * 3. Parks `-b` behind the new question (`lib/park.js`), the same fallback-to-`human`
 *    behaviour `bin/ask.js --blocks` has when the edge itself cannot be written.
 * 4. Records the filer's step on `-b`'s own relay trail (`lib/relayjournal.js`) — role
 *    `--from`, or the workspace relay's `filer` where neither is given; step `file`; no
 *    `--next`, for the reason above. Skipped, silently, where the workspace has no relay
 *    and no `--from` was given: there is no trail to write a role onto.
 * 5. Prints the packet id, the labels it now carries, the relay line (or that none was
 *    recorded), and — only when `--artifact` was not given — the Rule 1 verdict on
 *    whether a repo path written from here would reach a phone (`lib/reachable.js`).
 *    `dv-5eu.1.1`, `dv-gr6.41` and `dv-gr6.43` each re-derived this by hand, on a branch
 *    that was not trunk, and published an Artifact instead; this is that derivation, made
 *    once rather than re-argued per session. Pass `--artifact <url>` once you already have
 *    one — an Artifact is reachable from a phone by construction, so there is nothing
 *    left to verify.
 *
 * Exit codes: `1` usage, an unknown workspace, a body with no `decision` tail, or `-b`
 * naming a bead this workspace does not have — all refused before the create, so nothing
 * is on Adam's phone yet. `3` an unknown `--from` role, refused the same way. `0`
 * otherwise: the packet exists past that point, so nothing later may fail non-zero — a
 * failed park or a failed relay write is reported on stderr and the command still exits 0,
 * the same rule `bin/ask.js` follows for the reason given in its own header.
 */
import fs from 'node:fs';
import { execFileSync } from 'node:child_process';
import { loadConfig } from '../lib/config.js';
import { beadRow, park, questionType } from '../lib/park.js';
import { addresseeLabel, meHandles } from '../lib/addressee.js';
import { bylineFor } from '../lib/byline.js';
import { askTemplate, decisionTail } from '../lib/decision.js';
import { relayFor, packetFor, rolesOf } from '../lib/relay.js';
import { relayEntryBlock } from '../lib/relayjournal.js';
import { rule1Verdict } from '../lib/reachable.js';

const flag = (...names) => names.some((n) => process.argv.includes(n));
function arg(...names) {
  for (const n of names) {
    const i = process.argv.indexOf(n);
    if (i > -1) return process.argv[i + 1];
  }
  return undefined;
}

const USAGE =
  'usage: b7e-packet -w <workspace> -b <bead> -t <title> [-f packet.md] [--artifact <url>] ' +
  '[--from <role>] [--no-options]';

const cfg = loadConfig();
const wsName = arg('--workspace', '-w');
const beadId = arg('--bead', '-b');
const title = arg('--title', '-t');
const file = arg('--file', '-f');
const artifact = arg('--artifact');
const fromArg = String(arg('--from') || '').trim().toLowerCase();

const ws = cfg.workspaces.find((w) => w.name === wsName);
if (!ws || !beadId || !title) {
  console.error(USAGE);
  console.error(`workspaces: ${cfg.workspaces.map((w) => w.name).join(', ')}`);
  process.exit(1);
}

const body = file ? fs.readFileSync(file, 'utf8') : fs.readFileSync(0, 'utf8');

// The gate — see bin/ask.js's own header for why it is a refusal, before the create.
if (!flag('--no-options', '--free-text')) {
  const tail = decisionTail(body);
  if (!tail.ok) {
    console.error(`b7e-packet: nothing was asked — ${tail.reason}.`);
    console.error('');
    console.error('A question ends with its options, and one of them is recommended. Put this at the');
    console.error('bottom of the body, with nothing after it, and run it again:');
    console.error('');
    console.error(askTemplate('  '));
    console.error('');
    console.error('A packet that is a plain go/no-go rather than a choice: pass --no-options.');
    process.exit(1);
  }
}

const byline = bylineFor(cfg);
const env = { ...process.env, BEADS_DIR: ws.dir, BEADS_ACTOR: byline };
const bd = (args) =>
  execFileSync(cfg.bdBin, [...args, '--actor', byline], { env, cwd: ws.dir, encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });

// Everything that can still refuse the whole command happens here, before the create —
// the same order bin/ask.js's --blocks check follows, and for the same reason: past this
// point the question exists, and nothing may fail non-zero over a bead already on a phone.
const target = beadRow(bd, beadId);
if (!target) {
  console.error(`b7e-packet: no bead ${beadId} in ${ws.name} — nothing was asked. Check the id and run it again.`);
  process.exit(1);
}

const def = relayFor(cfg, ws.name);
const role = fromArg || (def ? String(def.filer || '').trim().toLowerCase() : '');
if (def && role && !rolesOf(def).has(role)) {
  console.error(`b7e-packet: --from \`${role}\` is not a role in ${ws.name} — one of: ${[...rolesOf(def)].sort().join(', ')}`);
  process.exit(3);
}

const type = questionType(target.issue_type);
const packetLabels = packetFor(cfg, ws.name);
const addressee = meHandles(cfg)[0] ?? '';
const forLabel = addresseeLabel(addressee);
const allLabels = [...packetLabels, ...(forLabel ? [forLabel] : [])];

const out = bd([
  'create',
  '--title', title,
  '--type', type,
  '--priority', '1',
  ...allLabels.flatMap((l) => ['--label', l]),
  '--description', body,
  '--json',
]);
const created = JSON.parse(out.slice(out.indexOf('{'), out.lastIndexOf('}') + 1));
const id = created.id || created.issue?.id;

// The question exists from here on — see the header. park() and the relay write both
// report rather than throw.
const { parked, note } = park(bd, beadId, id);
if (!parked) console.error(`b7e-packet: ${note}`);

let relayLine = 'relay: none recorded (no --from, and this workspace has no relay filer)';
if (role) {
  const block = relayEntryBlock({ role, step: 'file', note: `Filed review packet ${id}: ${title}` });
  try {
    bd(['update', beadId, '--append-notes', block]);
    relayLine = `relay: ${role} · file — filed review packet ${id}`;
  } catch (err) {
    const said = String(err?.stderr || err?.message || err).split('\n')[0];
    console.error(`b7e-packet: filed ${id}, but could not record the relay step on ${beadId} — ${said}`);
    relayLine = `relay: ${role} · file — NOT recorded (${said})`;
  }
}

console.log(id);
console.log(`labels: ${allLabels.join(', ')}`);
console.log(relayLine);
if (artifact) {
  console.log(`artifact: ${artifact}`);
} else {
  const verdict = rule1Verdict(process.cwd());
  console.log(`reachable: ${verdict.message}`);
}
