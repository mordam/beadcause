#!/usr/bin/env node
/**
 * Where in README.md something belongs, in one call instead of four to ten failed
 * greps — `lib/readme.js` does the parsing and matching; this is the argv shell.
 *
 *   b7e-readme <term> [<term> ...]   the smallest section mentioning all terms — see below
 *   b7e-readme --for <path>          same, with a literal file/route path as the one term
 *   b7e-readme --anchor <slug>       reverse lookup: the heading that slug names
 *   b7e-readme <term>... --sketch    only match inside a fenced ASCII sketch
 *   b7e-readme <term>... --json      machine-readable
 *   b7e-readme <term>... --dir <root>   another tree's README.md — this is how it is tested
 *
 * One term: every section that mentions it, one row per distinct heading, in document
 * order. Two or more: the smallest heading whose whole subtree contains every term at
 * least once — not the same as every term appearing on one line, and not the same as
 * "the first heading with any of them" either. See lib/readme.js's own header for the
 * full argument and the router/tailnet example it is built from.
 *
 * Exit codes: `0` something was found. `1` nothing matched — a real answer, not an
 * error (an anchor that resolves to no heading, terms that appear nowhere). `2` refused
 * — bad usage.
 */
import path from 'node:path';
import { analyze, findByAnchor, readReadme, searchSections } from '../lib/readme.js';

const argv = process.argv.slice(2);
const has = (f) => argv.includes(f);
const value = (f) => {
  const at = argv.indexOf(f);
  return at === -1 ? null : (argv[at + 1] ?? null);
};

const HELP = has('--help') || has('-h');
const USAGE = [
  'b7e-readme <term> [<term> ...]      the smallest section mentioning all terms',
  'b7e-readme --for <path>             same, with a literal path as the one term',
  'b7e-readme --anchor <slug>          reverse lookup: the heading that slug names',
  "b7e-readme <term>... --sketch       only match inside a fenced ASCII sketch",
  'b7e-readme <term>... --json         machine-readable',
  "b7e-readme <term>... --dir <root>   another tree's README.md",
].join('\n');

if (HELP) {
  console.log(USAGE);
  process.exit(0);
}

const DIR = value('--dir');
const FOR = value('--for');
const ANCHOR = value('--anchor');
const JSON_MODE = has('--json');
const SKETCH_ONLY = has('--sketch');

const FLAG_VALUES = new Set(['--dir', '--for', '--anchor']);
const FLAG_BARE = new Set(['--json', '--sketch', '--help', '-h']);
const terms = [];
for (let i = 0; i < argv.length; i += 1) {
  const a = argv[i];
  if (FLAG_VALUES.has(a)) {
    i += 1;
    continue;
  }
  if (FLAG_BARE.has(a)) continue;
  terms.push(a);
}

if (ANCHOR && (FOR || terms.length)) {
  console.error('--anchor is a reverse lookup on its own — it does not take search terms too\n\n' + USAGE);
  process.exit(2);
}
if (FOR && terms.length) {
  console.error('--for already supplies the one term to search for\n\n' + USAGE);
  process.exit(2);
}
if (!ANCHOR && !FOR && terms.length === 0) {
  console.error(USAGE);
  process.exit(2);
}

let text;
try {
  text = readReadme(DIR ? path.resolve(DIR) : undefined);
} catch (err) {
  console.error(`could not read README.md${DIR ? ` under ${DIR}` : ''}: ${err.message}`);
  process.exit(2);
}
const analysis = analyze(text);

const render = (h) => `${'#'.repeat(h.level)} ${h.title}`;
const printSection = (s) => {
  const kinds = s.kinds.length ? s.kinds.join(', ') : 'prose';
  console.log(`README.md:${s.startLine}-${s.endLine}  (${kinds})  #${s.slug}`);
  console.log(s.path.map(render).join(' → '));
};

// `process.exit(N)` right after a `--json` write here used to drop whatever of a
// caller-sized payload was still pending: stdout to a **pipe** is async, so it could cut
// at the 64KB pipe buffer with a success status and no signal at all (bc-dgx7.45,
// bc-dgx7.53). The if/else chains below are what stand in for the early returns
// `process.exit` used to give; falling off the end with `process.exitCode` set instead
// flushes.
if (ANCHOR) {
  const hits = findByAnchor(analysis, ANCHOR);
  if (JSON_MODE) {
    console.log(
      JSON.stringify(hits.map((s) => ({ startLine: s.startLine, endLine: s.endLine, slug: s.slug, path: s.path })))
    );
    process.exitCode = hits.length ? 0 : 1;
  } else if (!hits.length) {
    console.log(`no heading slugs to '#${ANCHOR.replace(/^#/, '')}'`);
    process.exitCode = 1;
  } else {
    if (hits.length > 1) {
      console.log(
        `${hits.length} headings share this slug — GitHub resolves an ambiguous link to the first one, below:\n`
      );
    }
    hits.forEach((s, i) => {
      if (i) console.log('');
      printSection(s);
    });
    process.exitCode = 0;
  }
} else {
  const queryTerms = FOR ? [FOR] : terms;
  const { mode, sections } = searchSections(analysis, queryTerms, { sketchOnly: SKETCH_ONLY });

  if (JSON_MODE) {
    console.log(
      JSON.stringify({
        mode,
        terms: queryTerms,
        sections: sections.map((s) => ({
          startLine: s.startLine,
          endLine: s.endLine,
          slug: s.slug,
          kinds: s.kinds,
          path: s.path.map((h) => ({ level: h.level, title: h.title, slug: h.slug })),
        })),
      })
    );
    process.exitCode = sections.length ? 0 : 1;
  } else if (!sections.length) {
    console.log(
      `nothing in README.md mentions ${queryTerms.map((t) => `'${t}'`).join(' and ')}${
        SKETCH_ONLY ? ' inside a fenced sketch' : ''
      }`
    );
    process.exitCode = 1;
  } else {
    if (mode === 'each' && queryTerms.length > 1) {
      console.log(`no single section mentions every term — nearest section per hit, in document order:\n`);
    }
    sections.forEach((s, i) => {
      if (i) console.log('');
      printSection(s);
    });
    process.exitCode = 0;
  }
}
