#!/usr/bin/env node
/**
 * `b7e-sh` — a multi-step shell script, run in one call the worktree's own Bash approval
 * would otherwise refuse as "too complex to verify that it stays inside the worktree".
 *
 *     b7e-sh script.sh
 *     b7e-sh script.sh --allow /tmp/some-tracker --allow /Users/me/scratch
 *     b7e-sh -c 'for f in a b c; do echo "$f"; done'
 *     b7e-sh script.sh --dry
 *     b7e-sh script.sh --cwd /path/to/some/other/worktree
 *
 * bc-ka5y.29 — filed by the session audit (`lib/sessionaudit.js`) against six sessions
 * that each hit this refusal and each worked around it a different way: bc-ka5y.19 split
 * a thirteen-line `sed` loop into thirteen single-line calls; bc-ka5y.22 and bc-1kwl.30
 * independently wrote the same disposable `run.sh`-into-`zsh` wrapper, neither knowing
 * the other had; bc-7qo.14 split a three-line `mktemp`+`mkdir`+`mkdir` into three calls
 * and pasted the resulting absolute path into every command after; bc-36xx.18 ran eleven
 * suites as eleven calls rather than one loop. Thirty-one refusals across the archives,
 * for work every one of those sessions was allowed to do — the refusal is not "this is
 * unsafe", it is "this Bash call is too complex to check", and the fix is not a wider
 * Bash allowance, it is moving the complexity into a *file* (which `Write` already
 * allows without complaint) and keeping the Bash call itself to one short, plain
 * invocation of this command.
 *
 * That only holds if what runs the file is actually held to the same bound the refusal
 * was protecting — a script this permits and then lets do anything is not a fix, it is a
 * bypass with extra steps. `lib/shguard.js` is the check: read the whole script before a
 * single line of it runs, and refuse anything that would touch outside the worktree
 * (`--cwd`, default the directory this is run from) or a named `--allow` root, the same
 * three shapes bc-ka5y.29's own evidence names — an absolute path outside them, a
 * `git -C` into the shared checkout, a `cd` that leaves them. It is a heuristic over the
 * script's *text*, not a sandbox: a target built from a shell variable cannot be resolved
 * ahead of time, so it is refused too, on the same "cannot verify" reasoning rather than
 * waved through as a false negative.
 *
 * Exit codes: `0` the script ran and exited `0`; the script's own exit code otherwise;
 * `2` refused — bad usage, or the verifier found a line that leaves the allowed roots.
 */
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { verifyScript } from '../lib/shguard.js';

const USAGE = `usage: b7e-sh <script.sh> [--cwd <dir>] [--allow <dir>]... [--dry]
       b7e-sh -c '<command>' [--cwd <dir>] [--allow <dir>]... [--dry]

Runs a shell script (or, with -c, a single command string that may itself be
multi-line) through bash, after checking it never leaves --cwd (default: the
directory this is run from) or any --allow root. --allow may be repeated —
name a mktemp dir or the session scratchpad if the script needs one.
/dev/null and friends are always allowed.

--dry verifies and prints what would run, without running it.

Exit codes: 0 the script ran and exited 0; the script's own exit code
otherwise; 2 refused — bad usage, or a line leaves the allowed roots.`;

const argv = process.argv.slice(2);
if (argv.includes('--help') || argv.includes('-h')) {
  console.log(USAGE);
  process.exit(0);
}

let scriptPath = null;
let inlineCommand = null;
let cwdArg = null;
const allow = [];
let dry = false;
const rest = [];

for (let i = 0; i < argv.length; i += 1) {
  const a = argv[i];
  if (a === '-c' || a === '--command') {
    inlineCommand = argv[i + 1];
    i += 1;
  } else if (a === '--cwd') {
    cwdArg = argv[i + 1];
    i += 1;
  } else if (a === '--allow') {
    allow.push(argv[i + 1]);
    i += 1;
  } else if (a === '--dry') {
    dry = true;
  } else {
    rest.push(a);
  }
}

if (inlineCommand !== null && rest.length) {
  console.error('b7e-sh: -c and a script path are two different ways in — use one');
  console.error(USAGE);
  process.exit(2);
}
if (inlineCommand === null && rest.length !== 1) {
  console.error('b7e-sh: give a script path, or -c \'<command>\'');
  console.error(USAGE);
  process.exit(2);
}
if (inlineCommand !== null && !inlineCommand) {
  console.error('b7e-sh: -c needs a command string');
  process.exit(2);
}

if (inlineCommand === null) {
  scriptPath = path.resolve(process.cwd(), rest[0]);
  if (!fs.existsSync(scriptPath)) {
    console.error(`b7e-sh: no such file: ${scriptPath}`);
    process.exit(2);
  }
}

const cwd = cwdArg ? path.resolve(process.cwd(), cwdArg) : process.cwd();
const roots = [cwd, ...allow.map((a) => path.resolve(process.cwd(), a))];
const text = inlineCommand !== null ? inlineCommand : fs.readFileSync(scriptPath, 'utf8');

const verdict = verifyScript(text, roots);
if (!verdict.ok) {
  console.error(
    `b7e-sh: refused — line ${verdict.line}: ${verdict.reason} (${verdict.target})\n` + `  ${verdict.text.trim()}`,
  );
  process.exit(2);
}

if (dry) {
  console.log(`b7e-sh: verified — would run in ${cwd}, allowed roots:`);
  for (const r of roots) console.log(`  ${r}`);
  process.exit(0);
}

const result =
  inlineCommand !== null
    ? spawnSync('bash', ['-c', inlineCommand], { cwd, stdio: 'inherit', env: process.env })
    : spawnSync('bash', [scriptPath], { cwd, stdio: 'inherit', env: process.env });

if (result.error) {
  console.error(`b7e-sh: ${result.error.message}`);
  process.exit(2);
}
if (result.signal) {
  console.error(`b7e-sh: script killed by ${result.signal}`);
  process.exit(1);
}
process.exit(result.status ?? 1);
