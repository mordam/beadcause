#!/usr/bin/env node
/**
 * `b7e-blame` — say whether a failing suite is already failing on `origin/main`.
 *
 *     b7e-blame <suite>...             blame each: your tree vs a detached origin/main
 *     b7e-blame --from <gate-log>      take every FAIL/TIMEOUT suite out of a b7e-gate log
 *     b7e-blame --dir <root>           "your tree" is <root>, not this repo's own root
 *     b7e-blame --timeout <s>          per-run seconds, both sides (default: lib/gate.js's own)
 *     b7e-blame --json                 one object per suite instead of the printed report
 *     b7e-blame --keep                 leave the origin/main scratch worktree in place
 *
 * bc-khoe.42: eight sessions each decided by hand, and by a different method, whether a
 * red suite was already red on `origin/main` — this is the one answer. `lib/blame.js`
 * carries the worktree, the running and the comparison; this file is the argv parsing
 * and the printing around it, the same split `b7e-gate` and `bin/b7e-gate` already use.
 *
 * Exit codes: `0` nothing here needs your attention (every failing suite given is
 * already failing on `origin/main` with the same named checks, or passed outright); `1`
 * at least one suite carries a failure `origin/main` does not have, in full or in part,
 * or could not be checked against it at all; `2` refused — bad usage, or no suites to
 * look at.
 */
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT, runBlame, suitesFromGateLog, verdictLine, exitCodeFor } from '../lib/blame.js';

const argv = process.argv.slice(2);
const has = (f) => argv.includes(f);
const value = (f, fallback) => {
  const inline = argv.find((a) => a.startsWith(`${f}=`));
  if (inline) return inline.slice(f.length + 1);
  const at = argv.indexOf(f);
  return at === -1 ? fallback : (argv[at + 1] ?? fallback);
};

if (has('--help') || has('-h')) {
  console.log(
    [
      'b7e-blame <suite>...             blame each: your tree vs a detached origin/main',
      'b7e-blame --from <gate-log>      take every FAIL/TIMEOUT suite out of a b7e-gate log',
      'b7e-blame --dir <root>           "your tree" is <root>, not this repo\'s own root',
      'b7e-blame --timeout <s>          per-run seconds, both sides',
      'b7e-blame --json                 one object per suite instead of the printed report',
      'b7e-blame --keep                 leave the origin/main scratch worktree in place',
    ].join('\n'),
  );
  process.exit(0);
}

const ROOT = path.resolve(value('--dir', REPO_ROOT));
const JSON_MODE = has('--json');
const KEEP = has('--keep');
const TIMEOUT_ARG = value('--timeout', null);
const TIMEOUT_MS = TIMEOUT_ARG == null ? null : Math.max(0, Number(TIMEOUT_ARG) || 0) * 1000;
const FROM = value('--from', null);

const dim = (s) => `\x1b[2m${s}\x1b[0m`;
const red = (s) => `\x1b[31m${s}\x1b[0m`;
const green = (s) => `\x1b[32m${s}\x1b[0m`;
const amber = (s) => `\x1b[33m${s}\x1b[0m`;

let suites = argv.filter((a, i) => !a.startsWith('-') && argv[i - 1] !== '--dir' && argv[i - 1] !== '--timeout' && argv[i - 1] !== '--from');

if (FROM) {
  let logText;
  try {
    logText = fs.readFileSync(path.resolve(FROM), 'utf8');
  } catch (err) {
    console.error(red(`could not read ${FROM} — ${err.message}`));
    process.exit(2);
  }
  suites = suites.concat(suitesFromGateLog(logText));
}
suites = [...new Set(suites)];

if (!suites.length) {
  console.error(red('nothing to blame — give one or more suite paths, or --from <gate-log>'));
  process.exit(2);
}

const colorFor = (verdict) =>
  verdict === 'clean' || verdict === 'main-red' ? green : verdict === 'partial' || verdict === 'yours' ? red : amber;

const { results, mainDir } = await runBlame(ROOT, suites, { timeoutOverrideMs: TIMEOUT_MS, keepWorktree: KEEP });
if (mainDir) console.error(dim(`origin/main worktree kept at ${mainDir}`));

if (JSON_MODE) {
  for (const r of results) console.log(JSON.stringify(r));
} else {
  for (const r of results) {
    const color = colorFor(r.verdict);
    console.log(color(verdictLine(r)));
    if (r.localFail?.length) {
      console.log(dim('  here:'));
      for (const name of r.localFail) console.log(dim(`    - ${name}`));
    }
    if (r.mainFail?.length) {
      console.log(dim('  on origin/main:'));
      for (const name of r.mainFail) console.log(dim(`    - ${name}`));
    }
  }
}

process.exit(exitCodeFor(results));
