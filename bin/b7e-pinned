#!/usr/bin/env node
/**
 * `b7e-pinned` — which `test/*.mjs` assertions are pinned to the exact words of a
 * module's generated prose, so a rewrap or a rewording can be checked against the list
 * before it ships rather than after a suite goes red.
 *
 *     b7e-pinned lib/session.js               every export's output, across all suites
 *     b7e-pinned lib/session.js workPromptFor  narrowed to one export's output
 *     b7e-pinned lib/session.js --json         one object instead of the printed report
 *     b7e-pinned --dir <root> lib/x.js         a different checkout, not this cwd
 *
 * bc-khoe.27.12 is the audit: three sessions each edited a generated brief by hand and
 * learned which words were load-bearing by breaking one and reading the failure. See
 * lib/pinned.js for the algorithm and its stated limits.
 *
 * For each pinned literal, three flags: `NOT IN SOURCE` (the exact substring, or for a
 * regex the pattern itself, does not appear in the module's source text today — a
 * stale pin, or one this static a read cannot trace through concatenation),
 * `HAS-NEWLINE` (a hard newline inside the pattern, so a rewrap breaks it — the
 * argument the bead itself was filed over), `HAS-NUMBER` (a digit or a spelled-out
 * count, which needs updating by hand every time the thing it counts changes).
 *
 * Exit codes: `0` — ran fine, whether or not anything was found (a report, not a
 * gate). `2` — the module path does not resolve to a file.
 *
 * @grant read
 */
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { pinnedIn } from '../lib/pinned.js';

const HERE = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.join(HERE, '..');

const argv = process.argv.slice(2);
const has = (f) => argv.includes(f);
const value = (f, fallback) => {
  const at = argv.indexOf(f);
  return at === -1 ? fallback : (argv[at + 1] ?? fallback);
};

if (has('--help') || has('-h')) {
  console.log(
    [
      'b7e-pinned <module> [builder]      every string/regex test/*.mjs pins to the',
      '                                    module\'s output (or, named, one export\'s)',
      'b7e-pinned <module> --json          one object instead of the printed report',
      'b7e-pinned --dir <root> <module>    a different checkout, not this process\'s cwd',
    ].join('\n'),
  );
  process.exit(0);
}

const DIR = path.resolve(value('--dir', ROOT));
const JSON_MODE = has('--json');
const positional = argv.filter((a, i) => !a.startsWith('-') && argv[i - 1] !== '--dir');
const moduleArg = positional[0];
const builder = positional[1] || null;

if (!moduleArg) {
  console.error('usage: b7e-pinned <module-path> [exported-builder-name]');
  process.exit(2);
}

/** `lib/session.js`, `session.js`, or an absolute path — whichever resolves first. */
function resolveModule(root, arg) {
  const direct = path.isAbsolute(arg) ? arg : path.join(root, arg);
  if (fs.existsSync(direct) && fs.statSync(direct).isFile()) return direct;
  const named = arg.endsWith('.js') ? arg : `${arg}.js`;
  for (const dir of ['lib', 'bin']) {
    const guess = path.join(root, dir, named);
    if (fs.existsSync(guess) && fs.statSync(guess).isFile()) return guess;
  }
  return null;
}

const modulePath = resolveModule(DIR, moduleArg);
if (!modulePath) {
  console.error(`could not resolve a module at or named "${moduleArg}" under ${DIR}`);
  process.exit(2);
}
const moduleBasename = path.basename(modulePath);
const moduleRel = path.relative(DIR, modulePath);
const moduleSource = fs.readFileSync(modulePath, 'utf8');

const suites = pinnedIn(DIR, moduleBasename, moduleSource, { builder });

if (JSON_MODE) {
  console.log(JSON.stringify({ module: moduleRel, builder, suites }, null, 2));
  process.exit(0);
}

if (suites.length === 0) process.exit(0);

const dim = (s) => `\x1b[2m${s}\x1b[0m`;
const red = (s) => `\x1b[31m${s}\x1b[0m`;
const yellow = (s) => `\x1b[33m${s}\x1b[0m`;

const total = suites.reduce((n, s) => n + s.findings.length, 0);
console.log(`${moduleRel}${builder ? ` (${builder})` : ''} — ${total} pinned literal(s) across ${suites.length} suite(s)\n`);
for (const suite of suites) {
  console.log(suite.file);
  for (const f of suite.findings) {
    const flags = [];
    if (!f.inSource) flags.push(red('NOT IN SOURCE'));
    if (f.hasNewline) flags.push(yellow('HAS-NEWLINE'));
    if (f.hasNumber) flags.push(dim('HAS-NUMBER'));
    const line = String(f.line).padStart(5, ' ');
    console.log(`  ${line}  ${f.raw}${flags.length ? `  ${flags.join('  ')}` : ''}`);
  }
  console.log('');
}
process.exit(0);
