#!/usr/bin/env node
/**
 * `b7e-retired` — which occurrences of a superseded figure are still an assertion, and
 * which are the record of its own retirement.
 *
 *     b7e-retired --value '80-100 m' --unit 'sea level'
 *     b7e-retired --value '80-100 m' --instead '~65 m' --unit 'sea level' reference/
 *     b7e-retired --value '80-100 m' --unit 'sea level' --datum-dir reference/regions/cycle1
 *     b7e-retired --value '4\'8"-5\'2"' --rev origin/main
 *     b7e-retired --value '80-100 m' --unit 'sea level' --json
 *     b7e-retired --value '80-100 m' --unit 'sea level' --dir <root>   # another tree — this is how it is tested
 *
 * `bc-dgx7.129`: four deluvia sessions (`dv-5i2.97`, `dv-5i2.92`, `dv-5i2.96`,
 * `dv-5i2.98`) each grepped a corpus for a retired number and then hand-sorted the
 * hits, and no two sorted them the same way — the sorting, not the search, is where the
 * calls went. `lib/retired.js` is the five checks that sorting actually took: a
 * `--datum-dir` a file is declared to live on, `--unit` (the same figure, a different
 * thing being measured), a `CHANGE_LOG.md` entry body, a table row/heading naming
 * Superseded/Retired/Entry NNN, and a "Notes for Adam"/worklog block. See that module's
 * header for the real examples each rule exists for.
 *
 * Exit codes: `0` LIVE is empty — nothing still asserts the retired figure. `1` LIVE is
 * non-empty. `2` bad usage.
 *
 * @grant read
 */
import path from 'node:path';
import { classify } from '../lib/retired.js';

const USAGE = `usage: b7e-retired --value <v> [--instead <v>] [--unit <noun>]
                   [--datum-dir <dir> ...] [--rev <ref>] [--dir <root>] [--json]
                   [<pathspec> ...]

Which occurrences of a superseded figure are still asserted, and which are the record
of its own retirement.

  --value <v>       the retired figure to search for, e.g. '80-100 m' — any '-' matches
                     hyphen, en dash, em dash or minus; any run of spaces matches any
                     whitespace
  --instead <v>     what replaced it, e.g. '~65 m' — carried into a LIVE match's reason
  --unit <noun>     the thing the number must modify, e.g. 'sea level' — a match with no
                     mention of this nearby is demoted to RECORDED as a different unit
  --datum-dir <dir> a tree declared to be on another datum entirely (repeatable) —
                     every match under it is RECORDED
  --rev <ref>       classify at a git ref instead of the working tree
  --dir <root>      scan this directory directly, ignoring cwd — this is how it is tested
  --json            the machine-readable form instead of the printed report
  <pathspec> ...    restrict the scan to these paths (default: the whole tree)`;

const argv = process.argv.slice(2);
if (argv.includes('--help') || argv.includes('-h')) {
  console.log(USAGE);
  process.exit(0);
}

function fail(msg) {
  console.error(`b7e-retired: ${msg}`);
  console.error(USAGE);
  process.exit(2);
}

let value = null;
let instead = null;
let unit = null;
let rev = null;
let dirGiven = null;
let jsonMode = false;
const datumDirs = [];
const pathspecs = [];

for (let i = 0; i < argv.length; i += 1) {
  const a = argv[i];
  const next = () => argv[(i += 1)];
  switch (a) {
    case '--value':
      value = next();
      break;
    case '--instead':
      instead = next();
      break;
    case '--unit':
      unit = next();
      break;
    case '--datum-dir':
      datumDirs.push(next());
      break;
    case '--rev':
      rev = next();
      break;
    case '--dir':
      dirGiven = next();
      break;
    case '--json':
      jsonMode = true;
      break;
    default:
      if (a.startsWith('--')) fail(`unrecognised flag: ${a}`);
      pathspecs.push(a);
  }
}

if (!value) fail('--value is required');

const dir = dirGiven ? path.resolve(dirGiven) : process.cwd();

const { live, recorded } = await classify(dir, {
  value,
  instead,
  unit,
  datumDirs,
  rev,
  pathspecs,
});

if (jsonMode) {
  console.log(JSON.stringify({ value, instead, unit, datumDirs, rev, live, recorded }));
  process.exit(live.length ? 1 : 0);
}

const dim = (s) => `\x1b[2m${s}\x1b[0m`;
const green = (s) => `\x1b[32m${s}\x1b[0m`;
const yellow = (s) => `\x1b[33m${s}\x1b[0m`;

console.log(yellow(`LIVE (${live.length}):`));
for (const r of live) {
  console.log(`  ${r.file}:${r.line}  ${r.text}`);
  console.log(dim(`      ${r.reason}`));
}
console.log('');
console.log(green(`RECORDED (${recorded.length}):`));
for (const r of recorded) {
  console.log(`  ${r.file}:${r.line}  ${r.text}`);
  console.log(dim(`      [${r.rule}] ${r.reason}`));
}

process.exit(live.length ? 1 : 0);
