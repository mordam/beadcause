#!/usr/bin/env node
/**
 * `b7e-known` — say whether the memory store already holds this, before it becomes a
 * fourth near-duplicate key.
 *
 *   b7e-known -w <workspace> [-b <bead>] [--file <path>]   prose on stdin, or --file
 *
 * bc-xl7n.112: three sessions (`bc-xl7n.83`, `bc-ywiy`, `bc-khoe.18`) each checked by
 * hand whether an insight was already on file before writing it down, no two the same
 * way — dumping `beadcause-memory notes` and grepping the output, guessing keys at
 * `recall`/`notes` and getting five empty answers in a row, and once searching the
 * *personal* memory directory instead of any of beadcause's own stores. `lib/memory.js`
 * already has the scorer for this question (`relevantNotes`, built to hand a bead its
 * notes) and nothing on the write side ever called it. This is that call: the prose an
 * agent is about to file, checked against the two keyed stores (`note`/`remember`) and —
 * when a bead is given — the debrief entries already on file for it and its family, all
 * ranked by `lib/memory.js`'s `nearestEntries`, the same tokenizer and the same validated
 * floor (`RELEVANT`) `relevantNotes` uses.
 *
 * **The debrief comparison needs `-b`, and that is not a missing feature.** Tier 4 is
 * deliberately never searched by similarity across the whole tracker — see
 * `debriefFamily`'s own header in lib/memory.js: a debrief's relevance to a bead is
 * graph-distance (self, parent, siblings), not vocabulary, so without a bead there is no
 * honest scope to check it against. `note`/`remember` still get checked with no `-b` at
 * all.
 *
 * **Only beadcause's three refs — `refs/beadcause/memory`, `refs/beadcause/agents/*` and
 * `refs/beadcause/sessions`/`refs/beadcause/debrief` — are ever read.** This never opens
 * a path under the personal memory directory bc-khoe.18 grepped instead; the only imports
 * here are `lib/memory.js` and `lib/sessionlog.js`, and neither of those takes one.
 *
 * Exit codes: `0` always, once argv parses and the prose is non-empty — this answers a
 * question, it does not gate anything. `2` bad usage, or nothing to check. `4` `-w`, an
 * *explicit* `-b`, or `--agent`, named something real does not have — an inherited
 * `$BEADCAUSE_BEAD` that does not resolve is not a failure, it is one fewer store checked.
 *
 * @grant read
 */
import fs from 'node:fs';
import { loadConfig } from '../lib/config.js';
import { Bd } from '../lib/bd.js';
import { resolveSessionDir } from '../lib/session.js';
import { recallDetail, notesIn, nearestEntries, debriefFamily, agents } from '../lib/memory.js';
import { debriefBeads, readDebriefs } from '../lib/sessionlog.js';

const argv = process.argv.slice(2);
const has = (f) => argv.includes(f);

function fail(msg, code = 2) {
  console.error(`b7e-known: ${msg}`);
  process.exit(code);
}

// A flag's value is never another flag and never absent. `--agent --json` used to hand
// "--json" through as an agent name and die on lib/memory.js's raw `bad agent` throw, and
// a trailing `-b` with nothing after it used to read as "no -b at all" — quietly answering
// a narrower question than the caller asked. Both are usage errors, and a usage error in
// this file is `fail(…, 2)`.
const value = (...names) => {
  for (const f of names) {
    const inline = argv.find((a) => a.startsWith(`${f}=`));
    if (inline) return inline.slice(f.length + 1);
    const at = argv.indexOf(f);
    if (at > -1) {
      const next = argv[at + 1];
      if (next === undefined) fail(`${f} needs a value`);
      if (next.startsWith('-')) fail(`${f} needs a value, not the flag "${next}"`);
      return next;
    }
  }
  return undefined;
};

const USAGE = `usage: b7e-known -w <workspace> [-b <bead>] [--file <path>]

Say whether the memory store already holds prose like this, before it becomes a fourth
near-duplicate key. The prose comes from --file <path> or stdin — never a shell
argument, so backticks and $(...) inside it are inert. Checks \`note\`/\`remember\`
always; checks the debrief entries for -b's bead and its family only when -b is given
(a debrief has no vocabulary-similarity search of its own — see the header comment).

  -w, --workspace <name>   which tracker (required; one of the configured workspaces)
  -b, --bead <id>          scope the debrief check to this bead and its family
  -f, --file <path>        read the prose from here instead of stdin
  --agent <id>             whose note/remember store to check (default: $BEADCAUSE_AGENT, else "worker")
  --keep <n>               how many hits to print at most (default 5)
  --json                   the machine-readable form instead of the printed report`;

if (has('--help') || has('-h')) {
  // `process.exit(0)` right after a `console.log` is the shape that dropped a pending
  // `--json` write below (see the note over the final `process.exitCode = 0`) — but not
  // here: USAGE is a fixed, small constant (well under a kilobyte), never `--keep`-scaled
  // or store-scaled the way a report is, so there is nothing async left pending to drop.
  console.log(USAGE);
  process.exit(0);
}

const wsName = value('-w', '--workspace');
// `$BEADCAUSE_BEAD` falls back the same way `whichBead()` in bin/beadcause-memory does —
// an agent session already has it stamped, and treating it as "no -b" would silently
// skip the debrief scope this same session's own `-b <bead>` would have gotten. Which of
// the two it came from is kept, because an unresolvable one means opposite things — see
// the resolve below.
const beadFlag = value('-b', '--bead');
let beadId = beadFlag || process.env.BEADCAUSE_BEAD || null;
const file = value('-f', '--file');
const who = value('--agent') || process.env.BEADCAUSE_AGENT || 'worker';
const keepRaw = value('--keep');
const KEEP = keepRaw === undefined ? 5 : Number(keepRaw);
const JSON_MODE = has('--json');

if (!wsName) fail(`-w/--workspace is required\n${USAGE}`);
// `Number(x) || 5` mapped both `--keep 0` and `--keep abc` onto the default, so a caller
// who asked for something impossible got five hits and no sign it had been overruled.
if (!Number.isInteger(KEEP) || KEEP < 1) fail(`--keep takes a positive whole number, not "${keepRaw}"`);

const cfg = loadConfig();
const ws = cfg.workspaces.find((w) => w.name === wsName);
if (!ws) {
  fail(`no workspace named "${wsName}"\nconfigured workspaces: ${cfg.workspaces.map((w) => w.name).join(', ') || 'none'}`, 4);
}

// bc-dgx7.46: an `--agent` naming no real store used to read an empty tier 2 and tier 1
// and print "nothing on file reads like this ... Safe to file a new key" — a confident
// all-clear indistinguishable from a genuinely fresh, correctly-named agent that just has
// not filed anything yet. `agents()` is tier 2's own roster (`lib/memory.js`'s "which
// agents have ever remembered anything"), and it is the one deterministic list this file
// can check a name against — tier 1 deliberately has no roster of its own, because a note
// store's agents vary by which repo the process is standing in (see lib/memory.js's note
// beside `agents()`). This cannot be a hard error on an empty *store* — a real agent that
// has genuinely never noted or remembered anything for this repo yet is a plausible state,
// and still answers 0/0 at exit 0 below — so the check is on the *name*, not the count.
const knownAgents = await agents();
if (!knownAgents.includes(who)) {
  fail(
    `--agent "${who}" has no store — known agents: ${knownAgents.join(', ') || 'none yet'}. ` +
      'A typo here used to read as a confident "nothing on file"; check the name.',
    4
  );
}

// An unreadable --file is bad usage like any other, not a raw ENOENT stack at exit 1 —
// the header documents 2 for that and this file otherwise keeps the convention.
let raw;
try {
  raw = file ? fs.readFileSync(file, 'utf8') : fs.readFileSync(0, 'utf8');
} catch (err) {
  const why = String(err?.message || err).split('\n')[0];
  fail(file ? `could not read --file ${file}: ${why}` : `could not read the prose from stdin: ${why}`);
}
const text = raw.trim();
if (!text) fail('nothing to check — pipe prose in or pass --file');

const bd = new Bd({ bin: cfg.bdBin, actor: cfg.actor, sharedServer: cfg.sharedServer, me: cfg.me });

let row = null;
if (beadId) {
  let why = null;
  try {
    row = await bd.show(ws, beadId);
  } catch (err) {
    why = String(err?.message || err).split('\n')[0];
  }
  if (!row) {
    // An explicit `-b` is a claim about the tracker, and a wrong one is worth failing on:
    // the caller asked for that scope and did not get it. An inherited `$BEADCAUSE_BEAD`
    // is not a claim — every agent session has one stamped, so a cross-workspace call, a
    // renamed bead, or a transient `bd` failure against the shared Dolt DB would otherwise
    // take the *whole* tool down, with note/remember needing no bead at all and the header
    // promising exit 0 because this does not gate anything.
    if (beadFlag) fail(why ? `${ws.name} has no bead ${beadId}: ${why}` : `${ws.name} has no bead ${beadId}`, 4);
    console.error(
      `b7e-known: $BEADCAUSE_BEAD is ${beadId}, which ${ws.name} does not have` +
        `${why ? ` (${why})` : ''} — checking note/remember only, pass -b to scope the debriefs.`
    );
    beadId = null;
  }
}

let dir;
try {
  dir = resolveSessionDir(cfg, ws, row);
} catch (err) {
  fail(`could not resolve a checkout for ${ws.name}: ${String(err?.message || err).split('\n')[0]}`, 4);
}

/* ------------------------------------------------------------------- gather candidates */

const remembered = await recallDetail(who);
const noted = await notesIn(dir, who);

const candidates = [
  ...Object.entries(remembered).map(([key, e]) => ({ store: 'remember', key, value: String(e?.value ?? ''), at: e?.at || '' })),
  ...Object.entries(noted).map(([key, e]) => ({ store: 'note', key, value: String(e?.value ?? ''), at: e?.at || '' })),
];

let debriefsChecked = 0;
if (row) {
  const ids = await debriefBeads(dir);
  const family = debriefFamily(ids, row);
  if (family.length) {
    const rows = await readDebriefs(dir, family, { perBead: 3, scan: 10 });
    debriefsChecked = rows.length;
    candidates.push(...rows.map((r) => ({ store: 'debrief', key: null, value: r.text, at: r.at || '', bead: r.bead, staged: r.staged })));
  }
}

const hits = nearestEntries(candidates, text, { keep: KEEP });

/* --------------------------------------------------------------------------- render */

const bead = beadId;
const beadArg = bead ? `-b ${bead}` : '-b <bead>';

function updateLine(hit) {
  if (hit.store === 'note') return `b7e-say -w ${ws.name} ${beadArg} --note ${hit.key}`;
  if (hit.store === 'remember') return `b7e-say -w ${ws.name} ${beadArg} --remember ${hit.key}`;
  // A debrief entry is append-only — there is no key to update in place, only a new
  // entry, which is what --debrief always writes. See lib/memory.js's own note on why
  // writes to tier 4 append rather than overwrite.
  return `(append-only — no key to update; a new run's report is \`b7e-say -w ${ws.name} ${beadArg} --debrief\`)`;
}

// A debrief's stored text is `renderDebrief`'s output, which opens with an
// `<agent> · <ISO>` stamp and a blank line before the report itself — so line one of every
// tier-4 hit was that byline, identical across hits, on the one line an agent reads to
// decide whether what is on file is what it was about to write. Skip the stamp. A report
// that is nothing but a stamp still shows the stamp, because that is all there is.
const STAMP = /^\S+ · (\d{4}-\d\d-\d\dT\S*|unknown time)$/;
const firstLine = (v, store) => {
  const lines = String(v).trim().split('\n');
  let i = 0;
  if (store === 'debrief') {
    while (i < lines.length && (!lines[i].trim() || STAMP.test(lines[i].trim()))) i += 1;
    if (i >= lines.length) i = 0;
  }
  return String(lines[i] ?? '').trim().slice(0, 160);
};

if (JSON_MODE) {
  console.log(
    JSON.stringify(
      {
        workspace: ws.name,
        bead,
        checked: { remember: Object.keys(remembered).length, note: Object.keys(noted).length, debrief: debriefsChecked },
        // `bead` and `staged` ride along because the printed renderer uses both to label a
        // hit, and every debrief hit has `key: null` — without them a machine consumer
        // cannot say which bead a tier-4 hit came from, or whether it is only staged, and
        // --json would be strictly less informative than the text the README describes.
        hits: hits.map((h) => ({
          store: h.store,
          key: h.key,
          score: h.score,
          at: h.at,
          bead: h.bead ?? null,
          staged: h.staged ?? false,
          preview: firstLine(h.value, h.store),
          value: h.value,
        })),
      },
      null,
      2
    )
  );
} else if (!hits.length) {
  const scope = row ? `, ${debriefsChecked} debrief entr${debriefsChecked === 1 ? 'y' : 'ies'} for ${bead} and its family` : '';
  console.log(
    `nothing on file reads like this — checked ${Object.keys(noted).length} note${Object.keys(noted).length === 1 ? '' : 's'}, ` +
      `${Object.keys(remembered).length} remember${Object.keys(remembered).length === 1 ? '' : 's'}${scope}. Safe to file a new key.`
  );
} else {
  console.log(`b7e-known · ${ws.name}${bead ? ` ${bead}` : ''}: ${hits.length} thing${hits.length === 1 ? '' : 's'} on file read like this\n`);
  for (const hit of hits) {
    const label = hit.store === 'debrief' ? `debrief entry (${hit.bead}${hit.staged ? ', pending archive' : ''})` : `${hit.store} \`${hit.key}\``;
    console.log(`${label}  —  score ${hit.score.toFixed(2)}`);
    console.log(`  ${firstLine(hit.value, hit.store)}`);
    console.log(`  ${updateLine(hit)}`);
    console.log('');
  }
}

// `process.exit(0)` here dropped whatever of the write above was still pending: stdout to
// a pipe is async, so `--json | jq` truncated at the 64KB pipe buffer — unparseable JSON
// with a success status and no signal at all — while the same run redirected to a file was
// whole. The payload is unbounded (hits carry each entry's full value, `--keep` is
// caller-set, and `readDebriefs` runs perBead 3 across a family), so that was the ordinary
// case rather than an edge one. Setting the code and falling off the end flushes.
process.exitCode = 0;
