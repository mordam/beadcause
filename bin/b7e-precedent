#!/usr/bin/env node
/**
 * `b7e-precedent` — the sibling bead that already did this shape of change, and the
 * patch it made.
 *
 *     b7e-precedent -w beadcause -b bc-khoe.30.22
 *     b7e-precedent -w beadcause -b bc-khoe.30.22 --file public/history.js
 *     b7e-precedent -w beadcause -b bc-dgx7.53 --root bc-dgx7
 *     b7e-precedent -w beadcause -b bc-khoe.30.22 --json
 *
 * bc-dgx7.64: four sessions each needed the same thing — what an earlier bead in their
 * own family had already committed, as a template to copy — and built it by hand, four
 * different ways, two of which guessed the wrong sibling first. lib/precedent.js is the
 * search; this file is only the argv parsing and the printing around it, same split as
 * `bin/b7e-siblings` and `bin/b7e-prior`.
 *
 * Every sibling under this bead's immediate parent (or `--root`, to widen past it) that
 * has landed work on `main` — a commit whose message opens with `<sibling-id>: `, the
 * merge queue's own convention — with its commit, pull request, merge date and the
 * files it touched. `--file <path>` narrows to the `sha^1..sha` diff for that path, from
 * whichever landed sibling last touched it.
 *
 * Exit codes: `0` ran to completion, whether or not anything landed — a family with
 * nothing on `main` yet is the ordinary "no precedent", not a failure. `2` bad usage.
 * `4` `-w`/`-b` named something this checkout's tracker does not have.
 *
 * @grant read
 */
import { loadConfig } from '../lib/config.js';
import { Bd } from '../lib/bd.js';
import { resolveSessionDir } from '../lib/session.js';
import { precedentFor, describePrecedent, lastToTouch, fileDiff } from '../lib/precedent.js';

const argv = process.argv.slice(2);
const has = (f) => argv.includes(f);
const value = (...names) => {
  for (const f of names) {
    const inline = argv.find((a) => a.startsWith(`${f}=`));
    if (inline) return inline.slice(f.length + 1);
    const at = argv.indexOf(f);
    if (at > -1) return argv[at + 1];
  }
  return undefined;
};

const USAGE = `usage: b7e-precedent -w <workspace> -b <bead> [--file <path>] [--root <id>] [--json]

The sibling bead that already did this shape of change, and the patch it made. One row
per sibling — under this bead's immediate parent, or --root to widen past it — that has
landed work on main: bead id, title, commit, pull request, merge date, files touched.

  -w, --workspace <name>   which tracker (required; one of the configured workspaces)
  -b, --bead <id>          the bead to find precedent for (required)
  --root <id>              search under this ancestor instead of the immediate parent
  --file <path>            print the sha^1..sha diff for one path from the most
                            recently landed sibling that touched it
  --json                   the machine-readable form instead of the printed report`;

if (has('--help') || has('-h')) {
  console.log(USAGE);
  process.exit(0);
}

const wsName = value('-w', '--workspace');
const beadId = value('-b', '--bead');
const rootFlag = value('--root');
const file = value('--file');
const JSON_MODE = has('--json');

function fail(msg, code = 2) {
  console.error(`b7e-precedent: ${msg}`);
  process.exit(code);
}

if (!wsName) fail(`-w/--workspace is required\n${USAGE}`);
if (!beadId) fail(`-b/--bead is required\n${USAGE}`);

const cfg = loadConfig();
const ws = cfg.workspaces.find((w) => w.name === wsName);
if (!ws) {
  fail(`no workspace named "${wsName}"\nconfigured workspaces: ${cfg.workspaces.map((w) => w.name).join(', ') || 'none'}`, 4);
}

const bd = new Bd({ bin: cfg.bdBin, actor: cfg.actor, sharedServer: cfg.sharedServer, me: cfg.me });

let row;
try {
  row = await bd.show(ws, beadId);
} catch (err) {
  fail(`${ws.name} has no bead ${beadId}: ${String(err?.message || err).split('\n')[0]}`, 4);
}
if (!row) fail(`${ws.name} has no bead ${beadId}`, 4);

const index = await bd.graph(ws);
const root = rootFlag || row.parent || index.parents.get(beadId) || null;

let dir;
try {
  dir = resolveSessionDir(cfg, ws, row);
} catch (err) {
  fail(`could not resolve a checkout for ${ws.name}: ${String(err?.message || err).split('\n')[0]}`, 4);
}

const found = await precedentFor(dir, index, beadId, root);

// `process.exit(0)` right after a write below used to drop whatever of it was still
// pending: stdout to a **pipe** is async, so a big `--json` run could cut at the 64KB
// pipe buffer with a success status and no signal at all (bc-dgx7.45). Falling off the
// end with `process.exitCode` set instead flushes.
if (file) {
  const hit = lastToTouch(found, file);
  if (JSON_MODE) {
    console.log(JSON.stringify({ workspace: ws.name, bead: beadId, root, file, sibling: hit ? { id: hit.id, sha: hit.sha } : null, diff: hit ? await fileDiff(dir, hit.sha, file) : '' }));
  } else if (!hit) {
    console.log(
      found.rows.length
        ? `None of the ${found.rows.length} landed sibling${found.rows.length === 1 ? '' : 's'} under ${root} touched ${file}.`
        : `No sibling under ${root || '(no parent)'} has landed anything on ${found.base} yet.`
    );
  } else {
    console.log(`${hit.id}${hit.pr ? ` (#${hit.pr})` : ''} — ${hit.sha}\n`);
    console.log(await fileDiff(dir, hit.sha, file));
  }
} else if (JSON_MODE) {
  console.log(JSON.stringify({ workspace: ws.name, bead: beadId, root, base: found.base, rows: found.rows }));
} else {
  for (const line of describePrecedent(found, beadId)) console.log(line);
}

process.exitCode = 0;
