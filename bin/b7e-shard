#!/usr/bin/env node
/**
 * `b7e-shard` — the `--index`-th of `--total` shards of the whole suite, one per line.
 *
 *     b7e-shard --index 0 --total 4        # this shard's suites, one per line
 *     b7e-shard --index 0 --total 4 --dir <root>
 *     b7e-shard --index 0 --total 4 --from affected.txt   # slice these suites, not all of them
 *     b7e-affected | b7e-shard --index 0 --total 4 --from -
 *
 * `.github/workflows/test.yml` is the caller: each matrix leg runs this to get its slice,
 * then feeds it straight to `bin/b7e-gate --only`. `lib/shard.js` carries the slicing
 * (stride, so the handful of expensive suites spread across shards instead of piling into
 * whichever one a contiguous block happens to land on) and reuses `lib/gate.js`'s
 * `discoverSuites()` — which already shells `scripts/test.mjs --list` — so this file adds
 * no second opinion about what a suite is, only argv parsing and the printing around it,
 * the same split every other `b7e-*` command uses.
 *
 * **`--from` is how a pull request runs only what it affects** (bc-xlz32.8): the file (or
 * `-` for stdin) holds `b7e-affected`'s answer, one suite per line, and the slice is taken
 * from that instead of from the whole roster. It is still `discoverSuites()` that decides
 * what a suite is and what order they come in — `narrowTo` intersects, it does not
 * reorder, and it drops names the gate does not know (browser checks) rather than passing
 * them on to `--only`, which would refuse them. An **empty `--from` means the whole
 * roster**, because that is what `b7e-affected` prints when it could not place a changed
 * file, and the fallback it is asking for is "run everything", not "run nothing".
 *
 * Exit codes: `0` printed (a shard can be an empty list — `--total` larger than the suite
 * count, or a narrow list shorter than `--total` — and that is not an error, just nothing
 * for that leg to run; **the caller must not turn an empty slice into a bare `b7e-gate`**,
 * which is every suite); `2` refused, bad usage.
 */
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT, discoverSuites } from '../lib/gate.js';
import { narrowTo, shardOf } from '../lib/shard.js';

const argv = process.argv.slice(2);
const value = (f) => {
  const at = argv.indexOf(f);
  return at === -1 ? undefined : argv[at + 1];
};

const ROOT = path.resolve(value('--dir') || REPO_ROOT);
const INDEX = Number(value('--index'));
const TOTAL = Number(value('--total'));

if (!Number.isInteger(TOTAL) || TOTAL < 1 || !Number.isInteger(INDEX) || INDEX < 0 || INDEX >= TOTAL) {
  console.error(`usage: b7e-shard --index <0..total-1> --total <n> [--dir <root>]`);
  console.error(`  got --index ${value('--index')} --total ${value('--total')}`);
  process.exit(2);
}

const FROM = value('--from');
let wanted = null;
if (FROM !== undefined) {
  let text;
  try {
    text = FROM === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(path.resolve(FROM), 'utf8');
  } catch (err) {
    console.error(`b7e-shard: cannot read --from ${FROM}: ${err.message}`);
    process.exit(2);
  }
  wanted = text.split('\n').map((s) => s.trim()).filter(Boolean);
}

const suites = narrowTo(discoverSuites(ROOT), wanted);
console.log(shardOf(suites, INDEX, TOTAL).join('\n'));
